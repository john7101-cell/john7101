# Claude (obligatorio). También funciona con `ant auth login` sin esta variable.
ANTHROPIC_API_KEY=
# Modelo y esfuerzo de razonamiento (opcional)
UGC_MODEL=claude-opus-5-5
UGC_EFFORT=high
# ElevenLabs (opcional): genera las voces en off de cada guion
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
