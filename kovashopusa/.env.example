# Credenciales de la API de USPS (https://developers.usps.com → My Apps).
# Déjalas vacías para usar el modo demo (datos simulados).
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# test = entorno de pruebas de USPS (apis-tem.usps.com) · production = apis.usps.com
USPS_ENV=test
# ZIP desde donde salen los paquetes (centro de fulfillment)
SHIP_FROM_ZIP=33166
PORT=3000
